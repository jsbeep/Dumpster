# 볼트 경로 (레포 루트 기준 상대경로 또는 절대경로)
# 기본값은 짜가 볼트. 실제 볼트로 바꾸려면 .env에서 DUMPSTER_VAULT=/home/<you>/obsidian
DUMPSTER_VAULT=fixtures/vault

# 공개할 컬렉션 폴더 (볼트 기준 경로, 쉼표 구분). 여기 없는 폴더는 전부 비공개.
# 하위 폴더는 자동으로 공개 (각각 하위 컬렉션이 됨)
DUMPSTER_PUBLIC=홈서버 구축기,블록 견본

# 공개 폴더 아래에서 무시할 폴더 이름 (쉼표 구분). 이 이름의 폴더는 그 아래까지 비공개.
# 이미지는 상관없이 씀 (첨부 폴더라서). 비우면 _image
DUMPSTER_IGNORE=_image

# graph.json 출력 위치 (레포 루트 기준)
DUMPSTER_OUT=out/graph.json

# 탐색기 dev 서버 (pnpm dev:web). 비우면 5320 · 127.0.0.1(이 기기에서만)
# 다른 기기에서 보려면 DUMPSTER_WEB_HOST=0.0.0.0
DUMPSTER_WEB_PORT=
DUMPSTER_WEB_HOST=
