{
  "name": "dumpster",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "graph": "pnpm --filter @dumpster/builder graph",
    "check:leak": "pnpm --filter @dumpster/builder check:leak",
    "dev:playground": "pnpm --filter @dumpster/playground dev",
    "dev:web": "pnpm --filter @dumpster/web dev",
    "build:web": "pnpm --filter @dumpster/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.74.0"
  }
}
